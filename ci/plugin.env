# Per-repository knobs for the pipeline in ci/ and .github/.
#
# Everything else under ci/ is identical across the Evolution CMS plugin
# repositories that share this pipeline, so a fix made in one is a fix that can
# be copied verbatim into the others. Only this file differs.

# Composer package name, exactly as declared in the plugin's composer.json.
PLUGIN_PACKAGE='elcreator/amount'

# Service provider, for `artisan vendor:publish --provider=`. Single-quoted:
# the backslashes are part of the class name, not escapes.
PLUGIN_PROVIDER='Elcreator\aMount\aMountServiceProvider'

# Directory name under core/custom/packages/, and the local docker image name.
PLUGIN_SLUG='amount'

# The CMS this plugin is built into.
EVO_REPO="${EVO_REPO:-https://github.com/evolution-cms/evolution}"
EVO_REF="${EVO_REF:-3.5.x}"
#EVO_REPO="${EVO_REPO:-https://github.com/elcreator/evolution}"
#EVO_REF="${EVO_REF:-feat-system-task-registry}"

# How the unit suite runs — see ci/run-tests.sh:
#   borrowed-core  the plugin has no vendor tree and borrows the core's
#                  autoloader and Pest binary (EVO_CORE_PATH_TEST)
#   own-vendor     the plugin has its own vendor tree and `composer test`
#   none           the plugin ships no suite; only the install smoke test runs
TEST_MODE='borrowed-core'
